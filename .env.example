# Application / JWT signing (required in production)
APP_ID=jagunco-standalone
APP_SECRET=
PORT=3000
HOST=0.0.0.0

# MySQL. Production refuses to boot without DATABASE_URL.
DATABASE_URL=mysql://jagunco:change-me@127.0.0.1:3306/jagunco

# Docker Compose only; use long random values in the real .env.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Optional: grant admin to an existing account at boot.
OWNER_EMAIL=

# Development-only switches. Never enable these in production.
# IS_SANDBOX=1
# SANDBOX_UNLIMITED=1
# DEBUG_PACKETS=1
